# Copy to backend/.env. Never commit real keys. Restart backend after editing.
GEMINI_API_KEY=
# Confirm a model enabled for your API key; change this if required.
GEMINI_MODEL=gemini-2.5-flash
PERCEPTRON_API_KEY=
# Use the exact model ID supplied by the Perceptron mentors if different.
PERCEPTRON_MODEL=perceptron-mk1.5
AI_TIMEOUT_MS=60000
# Each uploaded item can trigger at most this many background provider calls.
AI_PREFETCH_LIMIT_PER_ITEM=3
